# Copy this file to .env (`make setup` does it for you). .env is never committed.

# The local Supabase database, as printed by `supabase start`.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Optional: override business rules. The defaults match the design doc
# and live in services/bank_api/app/core/config.py.
# MAX_PIN_ATTEMPTS=3
# SESSION_IDLE_MINUTES=10
# DISPUTE_WINDOW_DAYS=60
# PER_TRANSFER_LIMIT_CENTS=250000
# DAILY_TRANSFER_LIMIT_CENTS=500000
# STEP_UP_THRESHOLD_CENTS=100000

# Demo only: return one-time codes in the API response, since there's no SMS.
# OTP_DEMO_MODE=true

# MCP server (services/mcp_server)
# BANK_API_URL=http://127.0.0.1:8000
# MCP_PORT=8100
# Local testing with a stdio client only: a token from `make mcp-token`.
# BANK_SESSION_TOKEN=

# Agent (services/agent)
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# ROUTER_MODEL=llama3.2:3b
# AGENT_MODEL=qwen2.5:7b      # or llama3.1:8b, to compare
# MCP_URL=http://127.0.0.1:8100/mcp
